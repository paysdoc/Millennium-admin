# Supabase — environment-agnostic
# The deployment environment determines which database these point to.
# In local dev, set these to your staging instance.
# In production, Vercel (or your hosting provider) sets these to the production instance.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Sync script (scripts/sync-supabase.ts) — CI/CD only
# The staging env vars below are only needed when running the sync script directly.
# They should be set in CI/CD secrets, not committed to .env.
# SUPABASE_URL_STAGING=
# SUPABASE_KEY_STAGING=
# SUPABASE_SERVICE_KEY_STAGING=

