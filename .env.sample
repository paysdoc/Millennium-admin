ENGINEER_NAME=

ANTHROPIC_API_KEY=
MAX_THINKING_TOKENS=63999
CLAUDE_CODE_PATH=
E2B_API_KEY=
GITHUB_PAT=
CLOUDFLARED_TUNNEL_TOKEN=

# Supabase — environment-agnostic
# The deployment environment determines which database these point to.
#
# For LOCAL development with Supabase CLI (supabase start):
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_KEY=<anon key from supabase status>
#   SUPABASE_SERVICE_KEY=<service_role key from supabase status>
#
# For PRODUCTION, Vercel sets these to the hosted Supabase instance.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Sync script (scripts/sync-supabase.ts) — CI/CD only
# CI pulls Supabase credentials from Vercel at runtime via `vercel env pull`.
# The staging env vars below are only needed when running the sync script locally.
# SUPABASE_URL_STAGING=
# SUPABASE_SERVICE_KEY_STAGING=

# Knex.js database migrations
# For LOCAL development: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# For PRODUCTION: set to the hosted Supabase Postgres connection string
DATABASE_URL=

VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_HQF1SOUMElzqB4p5W7MnfBfaWpnV
VERCEL_ORG_ID=team_6hmRdTXofBIeNvqXxLB5EVQR

# Webhook trigger port (used by adws/trigger_webhook.ts)
PORT=8001
